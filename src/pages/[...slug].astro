---
import '../styles/global.css'
import { getCollection } from 'astro:content'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (async () => {
  const pages = await getCollection('pages')

  return pages.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }))
}) satisfies GetStaticPaths

const { page } = Astro.props
const { Content } = await page.render()
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{page.data.title} - AkondAstro</title>
		<meta name="description" content={page.data.description || `Learn more about ${page.data.title} at AkondAstro.`} />
	</head>
	<body class="bg-slate-900 text-slate-50 min-h-screen">
		<!-- Header Bar -->
		<header class="bg-slate-800/50 backdrop-blur-sm border-b border-slate-700">
			<div class="container mx-auto px-6 py-4">
				<div class="flex items-center justify-between">
					<a href="/" class="flex items-center space-x-3 hover:opacity-80 transition-opacity">
						<img src="/assets/logos/brand/akondastro_logo_bright.svg" alt="AkondAstro" class="h-8" />
					</a>
					<nav class="hidden md:flex space-x-8">
						<a href="/#projects" class="text-slate-300 hover:text-blue-400 transition-colors">Projects</a>
						<a href="/#cooperation" class="text-slate-300 hover:text-blue-400 transition-colors">Cooperation</a>
						<a href="https://www.akond.com" class="text-slate-300 hover:text-blue-400 transition-colors">AkondLab</a>
					</nav>
				</div>
			</div>
		</header>

		<!-- Page Hero Section -->
		<section class="py-12 px-6 bg-slate-800/30 border-b border-slate-700">
			<div class="container mx-auto max-w-4xl">
				<a href="/" class="inline-flex items-center text-slate-400 hover:text-blue-400 transition-colors mb-6 text-sm">
					← Back to home
				</a>
				<div class="flex items-start gap-6">
					{page.data.logo && (
						<div class="w-20 h-20 bg-slate-700 rounded-xl flex items-center justify-center flex-shrink-0">
							<img src={page.data.logo} alt={page.data.title} class="w-16 h-16 object-contain" />
						</div>
					)}
					<div class="flex-1">
						<h1 class="text-4xl font-bold mb-3">{page.data.title}</h1>
						{page.data.externalUrl && (
							<a href={page.data.externalUrl} class="inline-flex items-center text-blue-400 hover:text-blue-300 transition-colors">
								Visit website →
							</a>
						)}
					</div>
				</div>
			</div>
		</section>

		<!-- Page Content -->
		<section class="py-16 px-6">
			<div class="container mx-auto max-w-4xl">
				<article class="prose-detail">
					<Content />
				</article>
			</div>
		</section>

		<!-- Footer -->
		<footer class="py-12 px-6 bg-slate-800/50 border-t border-slate-700 mt-20">
			<div class="container mx-auto text-center">
				<p class="text-slate-400 mb-4">
					For more information about our astronomical software solutions,
					visit <a href="https://www.akond.com" class="text-blue-400 hover:text-blue-300 underline">AkondLab</a>.
				</p>
				<p class="text-slate-500 text-sm">
					<a href="https://github.com/AkondLab/web-akondastro" class="hover:text-slate-400 underline">
						Source code available on GitHub
					</a>
				</p>
			</div>
		</footer>
	</body>
</html>
